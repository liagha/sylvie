hub.example.com {
	reverse_proxy 127.0.0.1:7400
	header {
		Strict-Transport-Security "max-age=31536000; include-subdomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	request_body {
		max_size 1GB
	}
}

